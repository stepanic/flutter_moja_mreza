{
  "manifest_version": 3,
  "name": "Uvoz s HEP-a za omm.domovina.ai",
  "short_name": "HEP uvoz",
  "version": "0.7.1",
  "description": "Uvoz očitanja, potrošnje i računa s Moje mreže, Mojeg računa i Hepija na omm.domovina.ai, nakon što se sam prijaviš.",
  "homepage_url": "https://omm.domovina.ai/",
  "icons": {
    "16": "ikone/ikona-16.png",
    "32": "ikone/ikona-32.png",
    "48": "ikone/ikona-48.png",
    "128": "ikone/ikona-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://omm.domovina.ai/*"],
      "js": ["omm.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Uvezi s HEP-a",
    "default_icon": {
      "16": "ikone/ikona-16.png",
      "32": "ikone/ikona-32.png"
    }
  }
}
